# Hermes Agent home (lives at ~/.hermes → symlink to .config/hermes).
# Secrets, runtime state, generated data, and the Hermes source must NEVER be
# committed. Track only portable config, persona, and explicitly maintained
# user skills.
.config/hermes/*
!.config/hermes/config.yaml
!.config/hermes/SOUL.md
!.config/hermes/skills/

# Ignore the bundled/shared skill library. The allowlist below contains only
# skills maintained in this dotfiles repository.
.config/hermes/skills/*
!.config/hermes/skills/native-app-launch-perf/
!.config/hermes/skills/native-app-launch-perf/SKILL.md
!.config/hermes/skills/native-app-launch-perf/references/
!.config/hermes/skills/native-app-launch-perf/references/**
!.config/hermes/skills/prose-deslop-audit/
!.config/hermes/skills/prose-deslop-audit/SKILL.md
!.config/hermes/skills/prose-deslop-audit/references/
!.config/hermes/skills/prose-deslop-audit/references/**
!.config/hermes/skills/hermes-skill-loading/
!.config/hermes/skills/hermes-skill-loading/SKILL.md
!.config/hermes/skills/hermes-skill-loading/references/
!.config/hermes/skills/hermes-skill-loading/references/**
!.config/hermes/skills/hermes-skills-loading/
!.config/hermes/skills/hermes-skills-loading/SKILL.md
!.config/hermes/skills/hermes-skills-loading/references/
!.config/hermes/skills/hermes-skills-loading/references/**
!.config/hermes/skills/software-development/
.config/hermes/skills/software-development/*
!.config/hermes/skills/software-development/revamp-web-dev/
!.config/hermes/skills/software-development/revamp-web-dev/SKILL.md
!.config/hermes/skills/software-development/revamp-web-dev/references/
!.config/hermes/skills/software-development/revamp-web-dev/references/**
!.config/hermes/skills/web-development/
.config/hermes/skills/web-development/*
!.config/hermes/skills/web-development/boneyard-skeleton-capture/
!.config/hermes/skills/web-development/boneyard-skeleton-capture/SKILL.md

# Skill runtime state (regenerated by Hermes, never commit).
.config/hermes/skills/.*

.config/cursor/*

.config/copilot/*
!.config/copilot/config.json

# SSH - exclude private keys and runtime files
.config/ssh/id_*
!.config/ssh/id_*.pub
.config/ssh/agent
.config/ssh/*.sock
.config/ssh/known_hosts

# .config/warp/
.config/warp/*
!.config/warp/themes/
!.config/warp/tab_configs/
.config/mole/clean-list.txt
.config/opencode/package-lock.json
.config/opencode/service-*.json
.config/opencode/antigravity-accounts.json
.config/zed/settings_backup.json
.config/raycast-x/extensions/*
.config/raycast-x/node-*/*
.config/homebrew/trust.json
.config/homebrew/trust.json.lock
.config/matplotlib/*
.config/snyk/*.log
.config/herdr/*.log
.config/herdr/*.sock
.config/fish/*
.config/colab-cli/*
.config/opencode/service.json
