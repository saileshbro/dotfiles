# Secrets — copy this file to `secrets` and fill in the values.
# `make setup-aliases` will symlink ~/dotfiles/secrets → ~/.secrets
# .zshenv sources ~/.secrets so these are available to ALL processes
# (including GUI apps like Claude Code that don't spawn an interactive shell).
#
# NEVER commit the `secrets` file — it is git-ignored.
#
# Tools that support env var expansion (set here, reference ${VAR} in config):
#   - Claude Code MCP server headers (~/.claude.json)
#
# Tools that do NOT support env var expansion (must be set manually in their UI):
#   - Zed: Settings > context_servers > exa/context7 > settings > api_key
#   - Kilo: Edit .config/kilo/kilo.jsonc --api-key argument directly (gitignored)

# ── MCP Servers ───────────────────────────────────────────────────────────────

# codewithbeto.dev MCP server (used in ~/.claude.json as ${CWB_MCP_TOKEN})
export CWB_MCP_TOKEN=""

# ── Zed / Kilo (for reference — set manually in each tool's config UI) ────────
# Exa.ai API key  →  Zed: context_servers > mcp-server-exa-search > exa_api_key
export EXA_API_KEY=""

# Context7 API key  →  Zed: context_servers > mcp-server-context7 > context7_api_key
#                   →  Kilo: .config/kilo/kilo.jsonc --api-key argument
export CONTEXT7_API_KEY=""
