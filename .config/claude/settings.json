{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "WebFetch",
      "Bash(bun *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(bunx *)",
      "Bash(node *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(python3 *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(mkdir *)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(source *)",
      "Bash(open *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(tee *)",
      "Read(/tmp/**)",
      "Edit(/tmp/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "mcp__plane__retrieve_work_item_by_identifier",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(git stash show *)",
      "Bash(pdfinfo *)",
      "Bash(xargs '-I{}' sh -c ' *)",
      "mcp__argent",
      "WebSearch",
      "Bash(brew list *)",
      "Bash(gpg --list-keys)",
      "Skill(update-config)",
      "Skill(humanizer)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(git rm *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.ssh/**)",
      "Read(**/secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "argent-create-flow": "off",
    "argent-metro-debugger": "off",
    "argent-react-native-optimization": "off",
    "argent-screenshot-diff": "off",
    "diagnosing-bugs": "off",
    "make-slides": "off",
    "research-topic": "off",
    "slides-with-research": "off",
    "expo-api-routes": "off",
    "expo-cicd-workflows": "off",
    "expo-tailwind-setup": "off",
    "frontend-design": "off",
    "turborepo": "off",
    "use-dom": "off",
    "dataviz": "off"
  },
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash /Users/saileshbro/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "expo@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "opus",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "iterm2_with_bell",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}