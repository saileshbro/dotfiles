{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "ls *": "allow",
      "flutter *": "allow",
      "fvm *": "allow",
      "rm *": "allow",
      "npx *": "allow",
      "head *": "allow",
      "npm run lint *": "allow",
      "npm ls *": "allow",
      "npm run lint:fix *": "allow",
      "git diff *": "allow",
      "yarn install *": "allow",
      "tail *": "allow",
      "yarn typecheck *": "allow",
      "bun lint *": "allow",
      "uv *": "allow",
      "make slides-m01 *": "allow",
      "latexmk *": "allow",
      "yarn add *": "allow",
      "npm install *": "allow",
      "yarn --version *": "allow",
      "yarn config *": "allow",
      "yarn cache *": "allow",
      "cat *": "allow",
      "$PYTHON *": "allow",
      "python3 *": "allow",
      "find *": "allow",
      "read *": "allow",
      "wc *": "allow",
      "tr *": "allow",
      "echo *": "allow",
      "sort *": "allow",
      "dirname *": "allow",
      "uniq *": "allow",
      "continue *": "allow",
      "basename *": "allow",
      "/Users/saileshbro/.local/share/uv/tools/graphifyy/bin/python *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "bun patch *": "allow",
      "mv *": "allow",
      "mkdir *": "allow",
      "git restore *": "allow",
      "git checkout *": "allow",
      "add *": "allow",
      "chat *": "allow",
      "home *": "allow",
      "macro *": "allow",
      "social *": "allow",
      "voice *": "allow",
      "_layout.tsx *": "allow",
      "cp *": "allow",
      "rmdir *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "gh issue view *": "allow",
      "bunx *": "allow",
      "bun run lint *": "allow",
      "bun run test *": "allow",
      "which *": "allow",
      "xcrun *": "allow",
      "grep *": "allow",
      "adb *": "allow",
      "argent *": "allow",
      "true *": "allow",
      "lsof *": "allow",
      "sleep *": "allow",
      "jq *": "allow",
      "awk *": "allow",
      "./node_modules/.bin/shadcn *": "allow",
      "node *": "allow"
    },
    "external_directory": {
      "/Users/saileshbro/.opencode/plans/*": "allow",
      "/Users/saileshbro/*": "allow",
      "/tmp/*": "allow"
    },
    "read": {
      "*": "allow"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "chrome-dev-tools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "-e",
        "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
      ]
    },
    "argent": {
      "type": "local",
      "command": ["argent", "mcp"]
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"]
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "notebooklm": {
      "type": "local",
      "command": ["npx", "-y", "notebooklm-mcp@latest"]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      }
    },
    "codewithbeto.dev": {
      "type": "remote",
      "url": "https://mcp.codewithbeto.dev",
      "headers": {
        "Authorization": "Bearer {env:CWB_MCP_TOKEN}"
      }
    },
    "plane": {
      "type": "remote",
      "url": "https://mcp.plane.so/http/mcp"
    },
    "cloudflare-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp"
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp"
    },
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp"
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    }
  }
}
