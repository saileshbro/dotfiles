{
  "cli_default_open_behavior": "existing_window",
  "use_system_window_tabs": true,
  "session": {
    "trust_all_worktrees": true
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "gemini": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "context_servers": {
    "mcp-server-exa-search": {
      "source": "custom",
      "enabled": true,
      "command": {
        "path": "npx",
        "args": ["-y", "exa-mcp-server"]
      }
    },
    "mcp-server-context7": {
      "source": "custom",
      "enabled": true,
      "command": {
        "path": "bunx",
        "args": ["-y", "@upstash/context7-mcp"]
      }
    },
    "codewithbeto.dev": {
      "source": "custom",
      "enabled": true,
      "command": {
        "path": "npx",
        "args": [
          "-y",
          "mcp-remote@latest",
          "https://mcp.codewithbeto.dev",
          "--transport",
          "http-only",
          "--header",
          "Authorization:Bearer ${CWB_MCP_TOKEN}"
        ]
      }
    },
    "argent": {
      "source": "custom",
      "command": "argent",
      "args": ["mcp"]
    },
    "shadcn": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "shadcn@latest", "mcp"]
      }
    },
    "chrome-devtools": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "chrome-devtools-mcp@latest", "-e", "/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"]
      }
    },
    "deepwiki": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://mcp.deepwiki.com/mcp", "--transport", "http-only"]
      }
    },
    "notebooklm": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "notebooklm-mcp@latest"]
      }
    },
    "plane": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://mcp.plane.so/http/mcp", "--transport", "http-only"]
      }
    },
    "cloudflare-api": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://mcp.cloudflare.com/mcp", "--transport", "http-only"]
      }
    },
    "cloudflare-bindings": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://bindings.mcp.cloudflare.com/mcp", "--transport", "http-only"]
      }
    },
    "cloudflare-builds": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://builds.mcp.cloudflare.com/mcp", "--transport", "http-only"]
      }
    },
    "cloudflare-docs": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://docs.mcp.cloudflare.com/mcp", "--transport", "http-only"]
      }
    },
    "cloudflare-observability": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://observability.mcp.cloudflare.com/mcp", "--transport", "http-only"]
      }
    },
    "expo": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://mcp.expo.dev/mcp", "--transport", "http-only"]
      }
    },
    "figma": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://mcp.figma.com/mcp", "--transport", "http-only"]
      }
    },
    "stitch": {
      "source": "custom",
      "command": {
        "path": "npx",
        "args": ["-y", "mcp-remote@latest", "https://stitch.googleapis.com/mcp", "--transport", "http-only"]
      }
    }
  },
  "agent": {
    "sidebar_side": "left",
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
      "tools": {
        "search_web": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://pub\\.dev"
            },
            {
              "pattern": "^https?://github\\.com"
            }
          ],
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^which\\s+flutterfire(\\s|$)"
            }
          ]
        }
      }
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true,
      "effort": "high"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "buffer_font_family": "Operator Mono",
  "terminal": {
    "font_family": "Operator Mono"
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Zed (Default)"
  },
  "vim_mode": true,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_family": ".SystemUIFont"
}
